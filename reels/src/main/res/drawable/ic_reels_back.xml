<?xml version="1.0" encoding="utf-8"?>
<!-- Left-curving turn arrow, traced from back-button.png. The viewport is cropped
     tightly around the artwork so the icon's bounds match the visible glyph. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="35dp"
    android:viewportWidth="344"
    android:viewportHeight="428">
    <group
        android:translateX="-78"
        android:translateY="-40">
        <!-- Arrowhead -->
        <path
            android:pathData="M198,57 L106,149 L198,241"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="21"
            android:strokeLineJoin="miter"
            android:strokeLineCap="butt" />
        <!-- Shaft: left, then curve down to a vertical tail -->
        <path
            android:pathData="M106,149 H280 A125,125 0 0 1 405,274 V458"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="21"
            android:strokeLineJoin="miter"
            android:strokeLineCap="butt" />
    </group>
</vector>
