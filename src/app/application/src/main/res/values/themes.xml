<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Test" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- System splash (androidx.core:core-splashscreen): shown on cold start, then hands over to Theme.Test. -->
    <style name="Theme.Test.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Test</item>
    </style>
</resources>
