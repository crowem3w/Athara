<?xml version="1.0" encoding="utf-8"?>
<!-- Testing: the backend runs on this phone (Termux) and serves plain HTTP on loopback.
     Cleartext is allowed ONLY for loopback hosts; everything else stays HTTPS.
     For a LAN IP, add a <domain> entry here. Remove before release (terminate TLS in front of the gateway). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
