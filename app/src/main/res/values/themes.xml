<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pure Compose app: this only needs to cover the brief window
         before Compose takes over (launch background, status/nav bar
         icon contrast), since all real theming lives in ui/theme/Theme.kt. -->
    <style name="Theme.Test" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch splash (androidx.core:core-splashscreen, backports the
         Android 12 splash API to API 30). Hands over to Theme.Test. -->
    <style name="Theme.Test.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Test</item>
    </style>

    <!-- Onboarding / Terms (moved from the former :onboarding module) -->
    <!-- Covers the brief window before Compose takes over. Light only for now. -->
    <style name="Theme.Onboarding" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/onboarding_background</item>
    </style>
</resources>
